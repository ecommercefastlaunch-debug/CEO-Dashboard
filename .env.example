# ── Database (Supabase → Project Settings → Database → Connection string) ──
# The app uses the pooled "Transaction" string (port 6543).
DATABASE_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Schema changes (npm run db:push) use the "Session" string (port 5432).
DIRECT_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

# ── Sign-in ──
# Signs the session cookie and encrypts stored channel secrets. 32+ random characters.
SESSION_SECRET=""
# The owner password: sees everything.
ADMIN_PASSWORD=""
# Optional. A second password that only opens the warehouse pages.
WAREHOUSE_PASSWORD=""

# ── Scheduled job ──
# Vercel sends this to /api/cron/daily. Any long random string.
CRON_SECRET=""
